---
import { getCollection } from 'astro:content';

const categories = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);

const pillTones = [
  'bg-bg/10 text-bg',
  'bg-bg/10 text-bg',
  'bg-accent text-bg',
  'bg-bg/10 text-bg',
  'bg-highlight text-fg',
  'bg-bg/10 text-bg',
  'bg-bg/10 text-bg',
  'bg-bg text-fg',
];

let i = 0;
---

<section id="competences" class="scroll-mt-20 bg-fg text-bg">
  <div class="mx-auto max-w-6xl px-6 py-20 md:px-10 md:py-28">
    <h2 class="font-display text-3xl font-black text-bg md:text-4xl">Compétences</h2>

    <div class="mt-10 flex flex-col gap-8">
      {categories.map(({ data }) => (
        <div class="reveal">
          <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-bg/50">{data.title}</h3>
          <ul class="mt-4 flex flex-wrap gap-3">
            {data.skills.map((skill) => {
              const tone = pillTones[i % pillTones.length];
              i += 1;
              return (
                <li class={`flex items-center gap-2 rounded-full px-4 py-2 font-semibold ${tone}`}>
                  <img src={`/${skill.icon}`} alt="" width="16" height="16" class="shrink-0" loading="lazy" />
                  <span class="text-sm">{skill.name}</span>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

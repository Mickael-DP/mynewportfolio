---
import { getCollection } from 'astro:content';

const categories = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);
---

<section id="competences" class="mx-auto max-w-6xl scroll-mt-20 border-t border-border px-6 py-20 md:px-10 md:py-28">
  <h2 class="font-display text-3xl font-semibold text-fg md:text-4xl">Compétences</h2>

  <div class="mt-10 grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-8">
    {categories.map(({ data }) => (
      <div class="reveal">
        <h3 class="font-mono text-xs uppercase tracking-wider text-accent">{data.title}</h3>
        <ul class="mt-5 space-y-3">
          {data.skills.map((skill) => (
            <li class="flex items-center gap-3 border-b border-border pb-3 text-sm text-secondary">
              <img src={`/${skill.icon}`} alt="" width="18" height="18" class="shrink-0" loading="lazy" />
              <span>{skill.name}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

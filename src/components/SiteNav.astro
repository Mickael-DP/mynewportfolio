---
const links = [
  { href: '#projets', label: 'Projets' },
  { href: '#experience', label: 'Expérience' },
  { href: '#competences', label: 'Compétences' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-50 border-b border-border bg-bg/90 backdrop-blur-none">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4 md:px-10">
    <a href="#top" class="font-display text-lg font-semibold tracking-tight text-fg">
      MDP<span class="text-accent">.</span>
    </a>

    <ul class="hidden items-center gap-8 font-mono text-xs uppercase tracking-wider text-secondary md:flex">
      {links.map((link) => (
        <li>
          <a href={link.href} class="transition-colors hover:text-accent">{link.label}</a>
        </li>
      ))}
    </ul>

    <a
      href="/assets/CV-DallePasqualine-Mickael.pdf"
      target="_blank"
      rel="noopener"
      class="border border-fg px-4 py-2 font-mono text-xs uppercase tracking-wider text-fg transition-colors hover:bg-fg hover:text-bg"
    >
      CV
    </a>
  </nav>

  <ul class="flex items-center gap-6 overflow-x-auto border-t border-border px-6 py-3 font-mono text-xs uppercase tracking-wider text-secondary md:hidden">
    {links.map((link) => (
      <li class="shrink-0">
        <a href={link.href} class="transition-colors hover:text-accent">{link.label}</a>
      </li>
    ))}
  </ul>
</header>

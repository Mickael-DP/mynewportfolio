---
const socials = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/mickael-dalle-pasqualine/' },
  { label: 'GitHub', href: 'https://github.com/Mickael-DP' },
  { label: 'Malt', href: 'https://www.malt.fr/profile/mickaeldallepasqualine' },
];
---

<footer class="border-t border-border">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-12 md:flex-row md:items-end md:justify-between md:px-10">
    <div>
      <p class="font-display text-xl font-extrabold text-fg">Mickael Dalle Pasqualine</p>
      <p class="mt-1 font-mono text-xs uppercase tracking-wider text-secondary">Pégomas, France</p>
    </div>

    <ul class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs uppercase tracking-wider text-secondary">
      {socials.map((social) => (
        <li>
          <a href={social.href} target="_blank" rel="noopener" class="transition-colors hover:text-accent">
            {social.label}
          </a>
        </li>
      ))}
      <li>
        <a href="mailto:m.dallepasqualine@gmail.com" class="transition-colors hover:text-accent">
          Email
        </a>
      </li>
    </ul>
  </div>

  <div class="border-t border-border px-6 py-4 md:px-10">
    <p class="font-mono text-xs text-muted">
      © {new Date().getFullYear()} Mickael Dalle Pasqualine
    </p>
  </div>
</footer>

---
import { Image } from 'astro:assets';
import { projectImages } from '../assets/projects';

interface Props {
  index: number;
  title: string;
  category: string;
  description: string;
  role: string;
  tags: string[];
  image: string;
  link?: string;
  github?: string;
  githubFront?: string;
  githubBack?: string;
}

const { index, title, category, description, role, tags, image, link, github, githubFront, githubBack } =
  Astro.props;

const number = String(index).padStart(2, '0');
const codeLinks = [
  github && { label: 'GitHub', href: github },
  githubFront && { label: 'GitHub (front)', href: githubFront },
  githubBack && { label: 'GitHub (back)', href: githubBack },
].filter(Boolean) as { label: string; href: string }[];
---

<article
  class="reveal border-t border-border py-12 first:border-t-0 md:py-16"
  style={`transition-delay: ${Math.min(index - 1, 4) * 60}ms`}
>
  <div class="grid grid-cols-1 gap-8 md:grid-cols-12 md:gap-10">
    <div class="md:col-span-4">
      <span class="index-number">{number}</span>
      <h3 class="mt-2 font-display text-2xl font-semibold text-fg md:text-3xl">{title}</h3>
      <p class="mt-1 font-mono text-xs uppercase tracking-wider text-muted">{category}</p>

      <ul class="mt-6 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <li class="border border-border px-3 py-1 font-mono text-[11px] uppercase tracking-wider text-secondary">
            {tag}
          </li>
        ))}
      </ul>

      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs uppercase tracking-wider">
        {link && (
          <a href={link} target="_blank" rel="noopener" class="text-fg transition-colors hover:text-accent">
            Voir le site →
          </a>
        )}
        {codeLinks.map((l) => (
          <a href={l.href} target="_blank" rel="noopener" class="text-secondary transition-colors hover:text-accent">
            {l.label} →
          </a>
        ))}
      </div>
    </div>

    <div class="md:col-span-8">
      <Image
        src={projectImages[image]}
        alt={`Aperçu du projet ${title}`}
        width={1200}
        height={675}
        class="w-full border border-border object-cover"
        loading={index <= 2 ? 'eager' : 'lazy'}
      />
      <p class="mt-6 text-base leading-relaxed text-secondary">{description}</p>
      <p class="mt-3 text-sm leading-relaxed text-muted">{role}</p>
    </div>
  </div>
</article>

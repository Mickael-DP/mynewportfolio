---
import ContactForm from './ContactForm';
---

<section id="contact" class="mx-auto max-w-3xl scroll-mt-20 border-t border-border px-6 py-20 md:px-10 md:py-28">
  <h2 class="font-display text-3xl font-black text-fg md:text-4xl">Contact</h2>
  <p class="mt-4 text-secondary">
    Une mission, un poste en CDI, une question&nbsp;? Écrivez-moi, je réponds rapidement.
  </p>

  <div class="mt-10">
    <ContactForm client:visible />
  </div>
</section>

---
import { getCollection } from 'astro:content';

const experience = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const education = (await getCollection('education')).sort((a, b) => a.data.order - b.data.order);
---

<section id="experience" class="mx-auto max-w-6xl scroll-mt-20 border-t border-border px-6 py-20 md:px-10 md:py-28">
  <h2 class="font-display text-3xl font-black text-fg md:text-4xl">Expérience</h2>

  <div class="mt-10">
    {experience.map(({ data }, i) => (
      <article class="reveal grid grid-cols-1 gap-4 border-t border-border py-10 first:border-t-0 md:grid-cols-12 md:gap-10">
        <div class="md:col-span-3">
          <span class="index-number">{String(i + 1).padStart(2, '0')}</span>
          <p class="mt-2 font-mono text-xs uppercase tracking-wider text-muted">{data.duration}</p>
        </div>

        <div class="md:col-span-9">
          <h3 class="font-display text-xl font-extrabold text-fg">{data.position}</h3>
          <p class="mt-1 font-mono text-xs uppercase tracking-wider text-accent">{data.company}</p>

          <ul class="mt-4 space-y-2">
            {data.descriptions.map((line) => (
              <li class="flex gap-3 text-sm leading-relaxed text-secondary">
                <span class="text-muted">—</span>
                <span>{line}</span>
              </li>
            ))}
          </ul>

          <ul class="mt-5 flex flex-wrap gap-2">
            {data.technologies.map((tech) => (
              <li class="rounded-full bg-mist px-3 py-1 font-mono text-[11px] font-semibold uppercase tracking-wider text-secondary">
                {tech}
              </li>
            ))}
          </ul>
        </div>
      </article>
    ))}
  </div>

  <h3 class="mt-16 font-display text-xl font-extrabold text-fg">Formation</h3>
  <div class="mt-6 grid grid-cols-1 gap-8 md:grid-cols-2">
    {education.map(({ data }) => (
      <div class="border-t border-border pt-6">
        <p class="font-mono text-xs uppercase tracking-wider text-muted">{data.year}</p>
        <h4 class="mt-2 font-display text-lg font-extrabold text-fg">{data.degree}</h4>
        <p class="mt-1 font-mono text-xs uppercase tracking-wider text-accent">{data.institution}</p>
        <p class="mt-3 text-sm leading-relaxed text-secondary">{data.detail}</p>
      </div>
    ))}
  </div>
</section>
